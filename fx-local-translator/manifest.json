{
  "manifest_version": 2,
  "name": "LocalLingo — Local AI Translator",
  "version": "1.1.2",
  "description": "Translate text and web pages with a local AI model (Ollama). Your text never leaves your machine.",
  "author": "Theo Kyriakidis",

  "browser_specific_settings": {
    "gecko": {
      "id": "locallingo@thekyr.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],

  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_title": "LocalLingo Translator"
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },

  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  }
}
